{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlexBooks",
  "version": "0.2.0",
  "identifier": "com.alextaxservices.alexbooks",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Alex Tax Services Corp",
    "copyright": "Alex Tax Services Corp",
    "shortDescription": "AlexBooks",
    "longDescription": "AlexBooks for Windows: the office's own window onto the AlexBooks server.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
